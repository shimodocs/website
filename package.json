{
  "name": "shimodocs-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/build-content.mjs",
    "build": "node scripts/build-content.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:client": "vite build",
    "build:seo": "node scripts/build-content.mjs && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "content": "node scripts/build-content.mjs",
    "check:contact": "node scripts/check-contact-fields.mjs",
    "assets": "python3 scripts/make-assets.py",
    "stats": "node scripts/download-stats.mjs",
    "stats:dry": "node scripts/download-stats.mjs --dry-run",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router": "latest",
    "react-router-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.1"
  }
}
